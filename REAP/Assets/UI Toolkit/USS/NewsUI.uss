/* YearlySummaryUI.uss */
.main-container {
    width: 100%;
    height: 100%;
    background-color: rgb(45, 45, 45);
    border-color: rgb(150, 150, 150);
    border-width: 2%;
    border-radius: 1%;
    padding: 2%;
}

.nav-container {
    flex-direction: row;
    height: 10%;
    margin-bottom: 2%;

}

.nav-button {
    flex-grow: 1;
    font-size: 60px;
    background-color: rgb(80, 80, 80);
    color: white;
    border-width: 0;
    border-radius: 0.5%;
    margin: 0 5px;
}

.nav-button:hover {
    background-color: rgb(100, 100, 100);
}

.nav-button.active-button {
    background-color: rgb(0, 122, 204);
    color: white;
}

.content-container {
    flex-grow: 1;
    background-color: rgb(60, 60, 60);
    border-radius: 5px;
    padding: 15px;
}

.page {
    flex-grow: 1;
}

/* Style for the summary label */
#SummaryLabel {
    color: white;
    font-size: 50px;
    -unity-text-align: center;
    white-space: normal; /* Allows text to wrap */
}